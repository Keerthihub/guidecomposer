{
  "name": "guidecomposer",
  "version": "0.1.1",
  "private": true,
  "description": "GuideComposer: a layout-grid panel for Adobe Illustrator (CEP extension).",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "test:ui": "node scripts/ui-smoke.js",
    "qa:illustrator": "scripts/qa/run-illustrator-qa.sh",
    "qa:indesign": "scripts/qa/run-indesign-qa.sh",
    "lint:es3": "node scripts/check-es3.js",
    "check": "npm run lint:es3 && npm test",
    "icons": "node scripts/make-icons.js",
    "build": "npm run check && node scripts/build.js",
    "sign:mac": "scripts/sign-zxp.sh",
    "rename": "node scripts/rename.js",
    "release:check": "node scripts/release-checks.js",
    "qa:panel": "node scripts/qa/panel/live-panel-qa.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "acorn": "^8.18.0"
  }
}
