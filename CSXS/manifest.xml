<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0" ExtensionBundleId="com.mullion.panel" ExtensionBundleVersion="0.1.0" ExtensionBundleName="Mullion" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <ExtensionList>
        <Extension Id="com.mullion.panel.main" Version="0.1.0"/>
    </ExtensionList>
    <ExecutionEnvironment>
        <HostList>
            <!-- Illustrator 2022 (26.0, CEP 11 / Chromium 88) and later. Narrow this to the versions you have tested. -->
            <Host Name="ILST" Version="[26.0,99.9]"/>
        </HostList>
        <LocaleList>
            <Locale Code="All"/>
        </LocaleList>
        <RequiredRuntimeList>
            <RequiredRuntime Name="CSXS" Version="11.0"/>
        </RequiredRuntimeList>
    </ExecutionEnvironment>
    <DispatchInfoList>
        <Extension Id="com.mullion.panel.main">
            <DispatchInfo>
                <Resources>
                    <MainPath>./client/index.html</MainPath>
                    <ScriptPath>./host/index.jsx</ScriptPath>
                    <CEFCommandLine/>
                </Resources>
                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>Mullion</Menu>
                    <Geometry>
                        <Size>
                            <Height>680</Height>
                            <Width>320</Width>
                        </Size>
                        <MinSize>
                            <Height>320</Height>
                            <Width>240</Width>
                        </MinSize>
                        <MaxSize>
                            <Height>2000</Height>
                            <Width>640</Width>
                        </MaxSize>
                    </Geometry>
                    <Icons>
                        <Icon Type="Normal">./icons/icon-normal.png</Icon>
                        <Icon Type="RollOver">./icons/icon-rollover.png</Icon>
                        <Icon Type="DarkNormal">./icons/icon-dark-normal.png</Icon>
                        <Icon Type="DarkRollOver">./icons/icon-dark-rollover.png</Icon>
                    </Icons>
                </UI>
            </DispatchInfo>
        </Extension>
    </DispatchInfoList>
</ExtensionManifest>
