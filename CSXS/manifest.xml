<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0" ExtensionBundleId="com.keerthi.guidecomposer" ExtensionBundleVersion="0.1.0" ExtensionBundleName="GuideComposer" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <ExtensionList>
        <Extension Id="com.keerthi.guidecomposer.main" Version="0.1.0"/>
    </ExtensionList>
    <ExecutionEnvironment>
        <HostList>
            <!-- Illustrator 2022 (26.0) and later: CEP 11 / Chromium 88.
                 InDesign ships in a later release. Its adapter and its QA script
                 are in the tree and tested against a simulated InDesign, but no
                 one has run them in InDesign, so IDSN is not declared here: an
                 undeclared host simply does not show the panel, which is the
                 honest behaviour until it has been run. To ship it, add a Host
                 entry named IDSN with range [17.0,99.9] alongside this one.
                 (Written out rather than shown as a tag: a commented-out tag
                 still looks like a declaration to anything parsing this file.) -->
            <Host Name="ILST" Version="[26.0,99.9]"/>
        </HostList>
        <LocaleList>
            <Locale Code="All"/>
        </LocaleList>
        <RequiredRuntimeList>
            <RequiredRuntime Name="CSXS" Version="11.0"/>
        </RequiredRuntimeList>
    </ExecutionEnvironment>
    <DispatchInfoList>
        <Extension Id="com.keerthi.guidecomposer.main">
            <DispatchInfo>
                <Resources>
                    <MainPath>./client/index.html</MainPath>
                    <ScriptPath>./host/index.jsx</ScriptPath>
                    <CEFCommandLine/>
                </Resources>
                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>GuideComposer</Menu>
                    <Geometry>
                        <Size>
                            <Height>680</Height>
                            <Width>320</Width>
                        </Size>
                        <MinSize>
                            <Height>320</Height>
                            <Width>240</Width>
                        </MinSize>
                        <MaxSize>
                            <Height>2000</Height>
                            <Width>640</Width>
                        </MaxSize>
                    </Geometry>
                    <Icons>
                        <Icon Type="Normal">./icons/icon-normal.png</Icon>
                        <Icon Type="RollOver">./icons/icon-rollover.png</Icon>
                        <Icon Type="DarkNormal">./icons/icon-dark-normal.png</Icon>
                        <Icon Type="DarkRollOver">./icons/icon-dark-rollover.png</Icon>
                    </Icons>
                </UI>
            </DispatchInfo>
        </Extension>
    </DispatchInfoList>
</ExtensionManifest>
